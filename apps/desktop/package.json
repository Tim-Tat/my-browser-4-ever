{
  "name": "aven",
  "productName": "Aven",
  "version": "0.0.1-alpha",
  "description": "Aven (My Browser 4 Ever): Electron-Fenster mit statischer Sidebar und einer echten Webseite",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "license": "UNLICENSED",
  "build": {
    "appId": "ch.tatula.aven",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
